# =============================================================================
# BIS AI Assistant - environment template
# Copy to .env and fill in. Every value has a working default: the prototype
# runs with an empty .env, using the in-memory index and the extractive composer.
# =============================================================================

# --- Language model (optional) -----------------------------------------------
# Without a key the assistant uses the extractive composer, which builds answers
# only from retrieved passages. It is less fluent, but it cannot hallucinate.
ANTHROPIC_API_KEY=
BIS_LLM_MODEL=claude-opus-5
# low | medium | high | xhigh | max. Unset inherits the model default.
BIS_LLM_EFFORT=
BIS_LLM_MAX_TOKENS=16000

# --- Database (optional) ------------------------------------------------------
# Unset -> in-memory JSON index. Set -> PostgreSQL + pgvector.
# DATABASE_URL=postgresql+psycopg://bis:bis@localhost:5432/bis
DATABASE_URL=
VECTOR_BACKEND=auto          # auto | pgvector | memory

# --- Embeddings ---------------------------------------------------------------
# local -> offline deterministic vectoriser (demo grade, no network)
# sbert -> sentence-transformers (pip install sentence-transformers)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Retrieval tuning ---------------------------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=40
MIN_EVIDENCE_SCORE=0.08
# Absolute admissibility floors. These are what make the assistant refuse
# off-topic questions. Raise MIN_SEMANTIC_SCORE to ~0.45-0.55 with sbert.
MIN_LEXICAL_SCORE=0.12
MIN_SEMANTIC_SCORE=0.30

# --- Security -----------------------------------------------------------------
# MUST be changed before any deployment.
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRY_MINUTES=720
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:3000
ADMIN_PASSWORD=admin123
USER_PASSWORD=user123

# --- Content ------------------------------------------------------------------
# Keep true while the knowledge base holds demo records. Setting it false hides
# the provenance banners, so only do that once real BIS data is loaded.
DEMO_MODE=true

# --- Frontend (server-side only; never exposed to the browser) -----------------
BIS_API_BASE=http://127.0.0.1:8000
